# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE / POSTGRESQL DATABASE (Vercel & Local Hosting)
# Otomatis terisi jika menghubungkan integrasi Supabase / Postgres di Vercel Dashboard:
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Opsional: Untuk akses client-side langsung ke Supabase (Vite)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
