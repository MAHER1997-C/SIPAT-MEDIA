# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE / POSTGRESQL DATABASE (Vercel & Local Hosting)
# Otomatis terisi jika menghubungkan integrasi Supabase / Postgres di Vercel Dashboard:
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_PRISMA_URL=""
POSTGRES_HOST=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Opsional: Untuk akses client-side langsung ke Supabase (Vite)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Opsional: Koneksi API Resmi Media Sosial @pondokqq (Instagram Graph API, TikTok API, atau RapidAPI)
IG_BUSINESS_ACCOUNT_ID=""
IG_ACCESS_TOKEN=""
TIKTOK_ACCESS_TOKEN=""
RAPIDAPI_KEY=""

